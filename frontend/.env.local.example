# ==========================================
# VARIABLES DE ENTORNO - FRONTEND
# ==========================================
#
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env.local (pnpm install lo hace solo si no existe)
# 2. NUNCA subas el archivo .env.local a Git
#
# Estos valores apuntan a la Supabase LOCAL del proyecto (`npx supabase start`),
# la misma que usa backend/.env.example. Tienen que ser del mismo proyecto que
# el backend: si no, el backend rechaza los tokens del login.
#
# Sin VITE_SUPABASE_URL la app arranca en modo demo (sin Supabase).
# ==========================================

# URL de Supabase. Local: API_URL de `npx supabase status`
VITE_SUPABASE_URL=http://127.0.0.1:55321

# Anon Key: pública, solo para el frontend.
# Local: ANON_KEY de `npx supabase status` (clave de demostración, pública)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# URL del backend (dev: puerto 3001)
VITE_API_URL=http://localhost:3001
