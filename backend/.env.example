# ==========================================
# VARIABLES DE ENTORNO - BACKEND
# ==========================================
#
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env (pnpm install lo hace solo si no existe)
# 2. NUNCA subas el archivo .env a Git
#
# Estos valores apuntan a la Supabase LOCAL del proyecto, así que el backend
# arranca desde cero sin ningún secreto:
#
#   npx supabase start      # Docker Desktop abierto; crea la BD desde supabase/migrations
#   npx supabase db reset   # opcional: vuelve al esquema y los datos de supabase/seed.sql
#
# La URL y la service key de abajo son las de demostración que trae la CLI de
# Supabase: públicas e iguales en toda instalación local. Las muestra
# `npx supabase status`.
#
# Para usar un proyecto de Supabase en la nube, pide la URL y la service_role
# key por privado. Nunca las pongas en este archivo: el repositorio es público.
# ==========================================

# ------------------------------------------
# SUPABASE
# ------------------------------------------

# URL del proyecto, sin /rest/v1/ al final. Local: API_URL de `npx supabase status`
SUPABASE_URL=http://127.0.0.1:55321

# Service Role Key: SOLO BACKEND, nunca al frontend.
# Local: SERVICE_ROLE_KEY de `npx supabase status` (clave de demostración, pública)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ------------------------------------------
# SERVIDOR
# ------------------------------------------
PORT=3001

# Origen que CORS deja pasar: donde corre el frontend
FRONTEND_URL=http://localhost:5173
