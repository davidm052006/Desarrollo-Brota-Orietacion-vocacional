        </mxCell>
        <mxCell id="p1_aC" edge="1" parent="1" source="p1_a3" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;" target="p1_a4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_pathB" parent="1" style="text;html=1;fontStyle=1;fontSize=13;fontColor=#b85450;align=left;" value="Camino B &amp;mdash; Falla la inserción (rollback)" vertex="1">
          <mxGeometry height="24" width="500" x="40" y="670" as="geometry" />
        </mxCell>
        <mxCell id="p1_b1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" value="1. Supabase Auth crea&#xa;la cuenta &amp;rarr; fila nueva&#xa;en auth.users" vertex="1">
          <mxGeometry height="120" width="170" x="40" y="710" as="geometry" />
        </mxCell>
        <mxCell id="p1_b2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" value="2. INSERT en&#xa;perfiles_usuario falla&#xa;(validación / constraint)" vertex="1">
          <mxGeometry height="120" width="170" x="270" y="710" as="geometry" />
        </mxCell>
        <mxCell id="p1_b3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" value="3. Backend revierte:&#xa;borra el usuario recién&#xa;creado en auth.users&#xa;(evita cuentas huérfanas)" vertex="1">
          <mxGeometry height="120" width="190" x="500" y="710" as="geometry" />
        </mxCell>
        <mxCell id="p1_b4" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" value="4. Registro no&#xa;completado &amp;mdash; el&#xa;usuario puede&#xa;intentar de nuevo" vertex="1">
          <mxGeometry height="120" width="170" x="750" y="710" as="geometry" />
        </mxCell>
        <mxCell id="p1_bA" edge="1" parent="1" source="p1_b1" style="endArrow=block;html=1;strokeColor=#b85450;strokeWidth=2;" target="p1_b2">
