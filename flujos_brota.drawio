        <mxCell id="p1_auth" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;fontSize=11;" value="&lt;b&gt;auth.users&lt;/b&gt; (Supabase Auth)&lt;br&gt;&lt;i&gt;fuera del esquema de Brota&lt;/i&gt;&lt;br&gt;id (UUID)&lt;br&gt;email, password hash&lt;br&gt;sesiones / tokens" vertex="1">
          <mxGeometry height="140" width="260" x="40" y="160" as="geometry" />
        </mxCell>
        <mxCell id="p1_pu" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;perfiles_usuario&lt;/b&gt;&lt;br&gt;&lt;u&gt;id&lt;/u&gt; (PK)&lt;br&gt;user_id (FK &amp;rarr; auth.users, CASCADE, UNIQUE)&lt;br&gt;rol: estudiante|orientador|&lt;br&gt;&amp;nbsp;&amp;nbsp;moderador|admin|institucion&lt;br&gt;nombre, apellido, edad, ciudad&lt;br&gt;nivel_educativo, grado, telefono&lt;br&gt;ultima_actividad, racha_dias&lt;br&gt;baneado_preguntas_hasta&lt;br&gt;bloqueado_hasta, permisos_override (JSONB)&lt;br&gt;institucion_id (FK &amp;rarr; instituciones, SET NULL)&lt;br&gt;institucion_contacto / institucion_descripcion&lt;br&gt;broti_config (JSONB)" vertex="1">
          <mxGeometry height="320" width="320" x="420" y="80" as="geometry" />
        </mxCell>
        <mxCell id="p1_inst" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;instituciones&lt;/b&gt;&lt;br&gt;&lt;u&gt;id&lt;/u&gt; (PK)&lt;br&gt;nombre, tipo, ciudad, departamento&lt;br&gt;direccion, telefono, email, sitio_web&lt;br&gt;costo_promedio&lt;br&gt;activa" vertex="1">
