        <mxCell id="p1_pathA" parent="1" style="text;html=1;fontStyle=1;fontSize=13;fontColor=#d79b00;align=left;" value="Camino A &amp;mdash; Registro exitoso" vertex="1">
          <mxGeometry height="24" width="500" x="40" y="480" as="geometry" />
        </mxCell>
        <mxCell id="p1_a1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="1. Persona completa&#xa;SignupCard (nombre,&#xa;email, clave, grado,&#xa;ciudad...)" vertex="1">
          <mxGeometry height="120" width="170" x="40" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p1_a2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="2. Supabase Auth crea&#xa;la cuenta &amp;rarr; fila nueva&#xa;en auth.users (id UUID)" vertex="1">
          <mxGeometry height="120" width="170" x="270" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p1_a3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="3. Backend crea&#xa;perfiles_usuario&#xa;(user_id = ese UUID,&#xa;rol=&#39;estudiante&#39;)" vertex="1">
          <mxGeometry height="120" width="170" x="500" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p1_a4" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="4. Si el rol es&#xa;&amp;quot;institucion&amp;quot;: se vincula&#xa;institucion_id (contacto/&#xa;descripcion propios)" vertex="1">
